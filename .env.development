# Base de la API REST, server-only (sin NEXT_PUBLIC_, sin barra final, el backend no usa prefijo /api — ver docs/CLAUDE.md). TEMPORAL: apunta a la API hosteada mientras el backend no corre en local; para volver a local, comentar esta línea y descomentar la de abajo.
API_BASE_URL=https://api.sienep.app
# API_BASE_URL=http://localhost:8080

# OAuth Client ID de Google (público). Sin esto, "Iniciar sesión con Google" queda deshabilitado.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=746115231904-rdks04rrv0ul2el05h04t9i387v135js.apps.googleusercontent.com
