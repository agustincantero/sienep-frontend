# Base de la API REST — la usa SOLO el server (el proxy de src/app/api/** y los
# Server Components). Sin NEXT_PUBLIC_: el navegador nunca le pega directo, va
# todo por /api. Sin barra final. El backend NO usa prefijo /api (ver docs/CLAUDE.md).
#
# TEMPORAL: mientras el backend no corra en local, se usa la API hosteada.
# Para volver a local, invertí los comentarios de las dos líneas de abajo.
API_BASE_URL=https://api.sienep.app
# API_BASE_URL=http://localhost:8080

# OAuth Client ID de Google (valor público; el mismo que verifica el backend en
# GOOGLE_OAUTH_CLIENT_ID). Sin esto, "Iniciar sesión con Google" queda deshabilitado.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=746115231904-rdks04rrv0ul2el05h04t9i387v135js.apps.googleusercontent.com
