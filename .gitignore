# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: los defaults por entorno se commitean; los .local (overrides personales) no
.env*
!.env
!.env.development
!.env.production
!.env.example

# docs/: solo se versionan el prototipo y el contrato de la API
/docs/*
!/docs/openapi.json
!/docs/prototipo.html
!/docs/wireframes.pdf

# claude code: solo se versiona skills/ (.agents/ y .claude/); el resto es personal.
/CLAUDE.md
CLAUDE.local.md
.claude/*
!.claude/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fotos de campus para el fondo del login: personales, quedan solo en local
/public/login-bg
