# Base de la API REST, server-only (sin NEXT_PUBLIC_, sin barra final): todo pasa por /api. Vercel toma este valor en `next build` (sobreescribible en Vercel > Project > Settings > Environment Variables).
API_BASE_URL=https://api.sienep.app

# OAuth Client ID de Google (público; el mismo que el backend valida en GOOGLE_OAUTH_CLIENT_ID). Sobreescribible desde el dashboard de Vercel.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=746115231904-rdks04rrv0ul2el05h04t9i387v135js.apps.googleusercontent.com
