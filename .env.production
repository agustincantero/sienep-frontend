# Base de la API REST — server-only (proxy de src/app/api/** y Server Components).
# Sin NEXT_PUBLIC_: el navegador nunca la ve, va todo por /api. Sin barra final.
# Vercel corre `next build` con NODE_ENV=production y toma este valor; se puede
# sobreescribir desde Vercel > Project > Settings > Environment Variables.
API_BASE_URL=https://api.sienep.app

# OAuth Client ID de Google (valor público; el mismo que verifica el backend en
# GOOGLE_OAUTH_CLIENT_ID). Se puede sobreescribir desde el dashboard de Vercel.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=746115231904-rdks04rrv0ul2el05h04t9i387v135js.apps.googleusercontent.com
