# Variables de entorno del frontend SIENEP.
#
# Los defaults por entorno ya vienen commiteados:
#   .env.development  -> usado por `next dev`
#   .env.production   -> usado por `next build` (https://api.sienep.app)
#
# Para un override personal (ej. apuntar a un backend remoto en desarrollo),
# copiá este archivo a `.env.local` y editá los valores. `.env.local` NO se
# commitea y tiene prioridad sobre .env.development / .env.production.

# Base de la API REST (sin barra final). Server-only: la usan el proxy de Next
# (src/app/api/**) y los Server Components. El navegador nunca le pega directo,
# va todo por /api, y el token viaja en una cookie httpOnly que el proxy inyecta.
API_BASE_URL=http://localhost:8080

# OAuth Client ID de Google para "Iniciar sesión con Google" (POST /auth/google).
# Valor público, el mismo que el backend usa en GOOGLE_OAUTH_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=746115231904-rdks04rrv0ul2el05h04t9i387v135js.apps.googleusercontent.com
